# ==============================================================================
# AI Stock Intelligence Platform - Environment Configuration Template
# Copy this file to .env (or backend/.env) and populate the values
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
# Example for Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For local SQLite fallback in dev/test: sqlite+aiosqlite:///./stock_intelligence.db
DATABASE_URL=sqlite+aiosqlite:///./stock_intelligence.db

# Market Data Providers
# Primary Indian Equity Provider: Upstox
# Leave blank to use deterministic MockMarketDataProvider
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=
DATA_PROVIDER=upstox

# Research & LLM Configuration
# Supports: openai, gemini, groq, mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MODEL_NAME=gpt-4o-mini

# Automated News & Crawling
NEWS_INGESTION_INTERVAL_MINUTES=60
MAX_NEWS_PER_REFRESH=20
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT=AIStockIntelligenceBot/1.0 (+https://github.com/example/stock-intelligence)

# Evaluation Framework
EVALUATION_DATASET_PATH=../data/evaluation/benchmark_dataset.json

